{
  "expo": {
    "name": "GatePass",
    "slug": "gatepass",
    "owner": "gatepassng",
    "version": "1.0.1",
    "scheme": "gatepass",
    "orientation": "portrait",
    "icon": "./src/assets/gatepass_ng_Gp.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#113E55"
    },
    "android": {
      "package": "com.gatepassng.gms",
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/android-adaptive-foreground.png",
        "backgroundColor": "#FFFFFF"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "app.gatepassng.com",
              "pathPrefix": "/activate"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        },
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "gatepass",
              "host": "*",
              "pathPrefix": "/auth/reset-password"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.gatepassng.gms",
      "associatedDomains": ["applinks:app.gatepassng.com", "applinks:app.gatepassng.com"],
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "image": "./src/assets/gatepass_ng_Gp.png",
      "favicon": "./src/assets/gatepass_ng_Gp.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#113E55",
          "dark": {
            "backgroundColor": "#113E55"
          }
        }
      ],
      "expo-secure-store"
    ],
    "assetBundlePatterns": ["**/*"],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "af7a228b-45e8-4505-bbef-4e9288d902e9"
      }
    }
  }
}
